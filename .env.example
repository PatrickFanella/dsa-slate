# Copy to .env for local development.
# Never commit .env.

PROJECT_NAME=dsa-slate

# Optional local Postgres profile used by docker-compose.yml.
POSTGRES_DB=dsa_slate
POSTGRES_USER=dsa_slate
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Optional future Google Civic Information API integration.
# Use an API key for anonymous public Civic lookups.
# Do not commit real keys or OAuth client secrets.
GOOGLE_CIVIC_API_KEY=

# Browser-facing base URL used to build the Google callback URL.
APP_BASE_URL=http://localhost:5173

# Google OIDC sign-in (Authorization Code + PKCE). Never commit real secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/google/callback

# Optional local-only admin bearer token for draft publish APIs.
ADMIN_API_TOKEN=
